# Copy this file to ".env" and fill in your key. Both jarvis.py and app.py
# load it automatically, so you won't have to export anything by hand.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional settings (uncomment to change):
# JARVIS_MODEL=claude-opus-4-8     # or claude-sonnet-4-6 / claude-haiku-4-5
# JARVIS_MEMORY=memory.md          # path to the long-term memory file
